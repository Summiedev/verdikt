<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <property name="LOG_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} %5p [%t] %c{1.} - %m%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <includeContext>false</includeContext>
            <fieldNames>
                <timestamp>timestamp</timestamp>
                <level>level</level>
                <thread>thread</thread>
                <logger>logger</logger>
                <message>message</message>
                <stackTrace>stack_trace</stackTrace>
            </fieldNames>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

    <logger name="com.verdikt" level="INFO"/>

    <logger name="org.springframework.web" level="INFO"/>

    <logger name="org.hibernate.SQL" level="WARN"/>

    <logger name="org.hibernate.orm.deprecation" level="WARN"/>

    <logger name="org.springframework.boot" level="INFO"/>

    <logger name="org.springframework.cache" level="INFO"/>

    <logger name="org.springframework.data.redis" level="INFO"/>

    <logger name="org.springframework.messaging" level="INFO"/>

    <logger name="org.springframework.scheduling" level="INFO"/>

    <logger name="org.springframework.transaction" level="INFO"/>

    <logger name="org.springframework.boot.actuator" level="INFO"/>

    <logger name="io.lettuce" level="WARN"/>

    <logger name="com.zaxxer.hikari" level="INFO"/>

    <logger name="org.postgresql" level="WARN"/>

    <logger name="org.flywaydb" level="INFO"/>

    <logger name="org.apache.catalina" level="WARN"/>

    <logger name="org.apache.tomcat" level="WARN"/>

    <springProfile name="local">
        <logger name="com.verdikt" level="DEBUG"/>
        <logger name="org.springframework.web" level="DEBUG"/>
        <logger name="org.hibernate.SQL" level="DEBUG"/>
    </springProfile>

</configuration>
